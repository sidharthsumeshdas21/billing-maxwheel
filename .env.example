# Copy this file to .env and fill in your values
# NEVER commit .env to git

SECRET_KEY=your-django-secret-key-here
DEBUG=True

# Supabase PostgreSQL connection string
# Format: postgresql://postgres:[password]@[host]:5432/postgres
DATABASE_URL=postgresql://postgres:your-password@db.xxxx.supabase.co:5432/postgres

# Allowed hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# Gemini AI — get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ── Twilio WhatsApp (for invoice notifications) ────────────────────────────
# Sign up at https://twilio.com — free trial gives ~$15 credit
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token-here
TWILIO_FROM_NUMBER=whatsapp:+1xxxxxxxxxx      # your Twilio WhatsApp sender number
TWILIO_CONTENT_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx  # optional pre-approved template SID
